{
    "name": "bltdreeg/core",
    "description": "Shared identity and tenant tenancy for the bltdreeg server apps",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "geoip2/geoip2": "^3.4",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-permission": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Bltdreeg\\Core\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bltdreeg\\Core\\Providers\\CoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
